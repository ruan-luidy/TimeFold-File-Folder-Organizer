<UserControl
    x:Class="TimeFold.Wpf.Shared.Controls.SelectField"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TimeFold.Wpf.Shared.Controls"
    xmlns:icons="clr-namespace:TimeFold.Wpf.Shared.Icons"
    x:Name="Root"
    Height="{StaticResource Toolbar.ControlHeight}">

    <UserControl.Resources>
        <!-- The closed box: same frame as the text fields -->
        <Style x:Key="SelectToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="Box"
                            Padding="8,0"
                            Background="{DynamicResource RegionBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Sm}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SecondaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelectItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="Row"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="{StaticResource Radius.Sm}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Selection.RowBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ToggleButton
            x:Name="Toggle"
            IsHitTestVisible="{Binding IsOpen, ElementName=DropDown, Converter={StaticResource Boolean2BooleanReConverter}}"
            Style="{StaticResource SelectToggle}">
            <DockPanel>
                <!-- the chevron turns up while the list is open -->
                <Path
                    Width="9"
                    Height="9"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Data="{icons:Phosphor CaretDownBold}"
                    DockPanel.Dock="Right"
                    Fill="{DynamicResource SecondaryTextBrush}"
                    RenderTransformOrigin="0.5,0.5"
                    Stretch="Uniform">
                    <Path.RenderTransform>
                        <RotateTransform />
                    </Path.RenderTransform>
                    <Path.Style>
                        <Style TargetType="Path">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=Toggle}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <TextBlock x:Name="Label" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </ToggleButton>

        <!-- 6 px from the field, below or above it; the margin is the room for the shadow (same as ShadowRoom) -->
        <Popup
            x:Name="DropDown"
            controls:DropDownPlacement.Gap="6"
            controls:DropDownPlacement.ShadowRoom="12,10,12,16"
            AllowsTransparency="True"
            IsOpen="{Binding IsChecked, ElementName=Toggle}"
            PlacementTarget="{Binding ElementName=Toggle}"
            PopupAnimation="Fade"
            StaysOpen="False">
            <Grid Margin="12,10,12,16">
                <Border Style="{StaticResource CardShadow}" />
                <Border
                    MinWidth="{Binding ActualWidth, ElementName=Toggle}"
                    Padding="4"
                    Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Lg}">
                    <ListBox
                        x:Name="Items"
                        MaxHeight="340"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource SelectItem}"
                        SelectionChanged="Items_SelectionChanged">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Margin="8,8,0,3"
                                            FontSize="{StaticResource FontSize.XS}"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource ThirdlyTextBrush}"
                                            Text="{Binding Name}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>
                </Border>
            </Grid>
        </Popup>
    </Grid>
</UserControl>
