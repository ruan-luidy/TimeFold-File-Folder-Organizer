<controls:DialogCard
    x:Class="TimeFold.Wpf.Shared.Controls.TextPromptDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TimeFold.Wpf.Shared.Controls"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    Width="420"
    Background="Transparent">

    <Border Style="{StaticResource DialogBorderAnimated}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="24,20,24,18">
                <TextBlock x:Name="TitleText" Style="{StaticResource DialogTitle}" />
                <TextBlock x:Name="LabelText" Margin="0,10,0,6" Style="{StaticResource CaptionText}" />
                <hc:TextBox
                    x:Name="Input"
                    Height="30"
                    hc:InfoElement.ContentHeight="30"
                    FontSize="{StaticResource FontSize.Body}"
                    KeyDown="Input_KeyDown"
                    TextChanged="Input_TextChanged" />
                <TextBlock
                    x:Name="ErrorText"
                    Margin="0,6,0,0"
                    FontSize="{StaticResource FontSize.Sm}"
                    Foreground="{DynamicResource DangerBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource DialogFooter}">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        MinWidth="90"
                        Margin="0,0,10,0"
                        Click="Cancel_Click"
                        Content="Cancel"
                        Style="{StaticResource ButtonDefault}" />
                    <Button
                        x:Name="ConfirmButton"
                        MinWidth="90"
                        Click="Confirm_Click"
                        Style="{StaticResource ButtonPrimary}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</controls:DialogCard>
