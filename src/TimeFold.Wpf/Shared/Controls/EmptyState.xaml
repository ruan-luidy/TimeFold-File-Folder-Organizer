<UserControl
    x:Class="TimeFold.Wpf.Shared.Controls.EmptyState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    IsTabStop="False">

    <!-- Empty panel: faded icon, a title, the hint, and an action button when it makes sense -->
    <StackPanel MaxWidth="420" Margin="24,12">
        <Grid Width="56" Height="56" HorizontalAlignment="Center">
            <Border Background="{DynamicResource Accent.SoftBrush}" CornerRadius="28" />
            <Path
                Width="24"
                Height="24"
                Data="{Binding Icon, ElementName=Root}"
                Fill="{DynamicResource PrimaryBrush}"
                Stretch="Uniform" />
        </Grid>

        <TextBlock
            Margin="0,14,0,0"
            HorizontalAlignment="Center"
            FontSize="{StaticResource FontSize.Md}"
            FontWeight="SemiBold"
            Foreground="{DynamicResource PrimaryTextBrush}"
            Text="{Binding Title, ElementName=Root}" />

        <TextBlock
            Margin="0,6,0,0"
            FontSize="{StaticResource FontSize.Sm}"
            Foreground="{DynamicResource SecondaryTextBrush}"
            Text="{Binding Text, ElementName=Root}"
            TextAlignment="Center"
            TextWrapping="Wrap" />

        <Button
            Margin="0,14,0,0"
            HorizontalAlignment="Center"
            Command="{Binding ActionCommand, ElementName=Root}"
            Content="{Binding ActionText, ElementName=Root}"
            Style="{StaticResource ToolbarButtonPrimary}"
            Visibility="{Binding ActionText, ElementName=Root, Converter={StaticResource String2VisibilityConverter}}" />
    </StackPanel>
</UserControl>
