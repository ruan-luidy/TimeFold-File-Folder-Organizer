<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:TimeFold.Wpf.Shared.Behaviors"
    xmlns:controls="clr-namespace:TimeFold.Wpf.Shared.Controls"
    xmlns:converters="clr-namespace:TimeFold.Wpf.Shared.Converters"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!--
        Design system of the Terminal app. Theme colours come from HandyControl (RegionBrush, PrimaryTextBrush...);
        the few brushes of our own that change with light/dark are set by ThemeService.
        A region (card, panel, popup) uses Radius.Lg; anything the height of a control uses Radius.Sm.
    -->

    <system:Double x:Key="Spacing.Sm">8</system:Double>
    <system:Double x:Key="Spacing.Md">12</system:Double>
    <system:Double x:Key="Spacing.Lg">16</system:Double>

    <Thickness x:Key="Padding.Card">12,10</Thickness>

    <CornerRadius x:Key="Radius.Sm">4</CornerRadius>
    <CornerRadius x:Key="Radius.Md">6</CornerRadius>
    <CornerRadius x:Key="Radius.Lg">8</CornerRadius>
    <CornerRadius x:Key="Radius.XL">12</CornerRadius>

    <!-- One height for every field, button and segmented control in a toolbar -->
    <system:Double x:Key="Toolbar.ControlHeight">26</system:Double>

    <system:Double x:Key="FontSize.XS">11</system:Double>
    <system:Double x:Key="FontSize.Sm">12</system:Double>
    <system:Double x:Key="FontSize.Body">13</system:Double>
    <system:Double x:Key="FontSize.Md">14</system:Double>
    <system:Double x:Key="FontSize.Lg">16</system:Double>
    <system:Double x:Key="FontSize.Title">20</system:Double>
    <system:Double x:Key="FontSize.Display">28</system:Double>

    <FontFamily x:Key="FontFamily.Numbers">Consolas</FontFamily>

    <Color x:Key="ColorAccent">#3778bf</Color>

    <!-- Dark values; ThemeService swaps them for the light theme -->
    <SolidColorBrush x:Key="Workspace.BackgroundBrush" Color="#111113" />
    <SolidColorBrush x:Key="Hover.RowBrush" Opacity="0.06" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Target.Brush" Color="#5B9BE0" />
    <SolidColorBrush x:Key="Target.CustomBrush" Color="#C084FC" />
    <SolidColorBrush x:Key="DropZone.Brush" Opacity="0.10" Color="{StaticResource ColorAccent}" />

    <SolidColorBrush x:Key="Selection.RowBrush" Opacity="0.28" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="Accent.SoftBrush" Opacity="0.14" Color="{StaticResource ColorAccent}" />

    <DropShadowEffect
        x:Key="Shadow.Card"
        BlurRadius="28"
        Direction="270"
        Opacity="0.45"
        ShadowDepth="8"
        Color="Black" />

    <!-- Popup shadow: on its own border behind the card (an Effect on the card itself kills ClearType) -->
    <DropShadowEffect
        x:Key="Shadow.Popup"
        BlurRadius="12"
        Direction="270"
        Opacity="0.4"
        ShadowDepth="3"
        Color="Black" />

    <Style x:Key="CardShadow" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
        <Setter Property="Effect" Value="{StaticResource Shadow.Popup}" />
    </Style>

    <!-- Icons: <Path Data="{icons:Phosphor GearSixBold}" Style="{StaticResource Icon}" />, filled with the text colour -->
    <Style x:Key="Icon" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Icon.Small" BasedOn="{StaticResource Icon}" TargetType="Path">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>

    <Style x:Key="Icon.Large" BasedOn="{StaticResource Icon}" TargetType="Path">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
    </Style>

    <!-- A panel of the app: a card on the workspace background -->
    <Style x:Key="SurfaceCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
        <Setter Property="Padding" Value="{StaticResource Padding.Card}" />
    </Style>

    <!-- Small caps heading of a panel (SOURCE, LIVE PREVIEW) -->
    <Style x:Key="PanelHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.XS}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="NumberText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Numbers}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <!-- A path shown as text: mono, trimmed in the middle by the tooltip -->
    <Style x:Key="PathText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Numbers}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Style>

    <!-- Big number over a label (completion stats, undo preflight) -->
    <Style x:Key="StatValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Numbers}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Display}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="StatLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.XS}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>

    <!--
        Segmented group: a box with the options inside, the chosen one filled with the accent.
        <Border Style="{StaticResource SegmentedGroup}"><StackPanel Orientation="Horizontal">
            <RadioButton Style="{StaticResource SegmentedRadio}" /> ...
    -->
    <Style x:Key="SegmentedGroup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}" />
        <Setter Property="Height" Value="{StaticResource Toolbar.ControlHeight}" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SegmentedRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        x:Name="Segment"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Segment" Property="Background" Value="{DynamicResource Hover.RowBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Segment" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Option card: a row with an icon, a title and a line under it; checked = accent border.
        Used for the organization modes and the theme choice.
    -->
    <Style x:Key="OptionCard" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        x:Name="Card"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Md}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource Hover.RowBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource Accent.SoftBrush}" />
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toolbar fields and buttons: one height, based on HandyControl's small styles -->
    <Style x:Key="ToolbarTextBox" BasedOn="{StaticResource TextBoxExtend.Small}" TargetType="{x:Type hc:TextBox}">
        <Setter Property="Height" Value="{StaticResource Toolbar.ControlHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="hc:InfoElement.MinContentHeight" Value="0" />
        <Setter Property="hc:InfoElement.ContentHeight" Value="{StaticResource Toolbar.ControlHeight}" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
    </Style>

    <Style BasedOn="{StaticResource ToolbarTextBox}" TargetType="{x:Type hc:TextBox}" />

    <Style x:Key="ToolbarButton" BasedOn="{StaticResource ButtonDefault.Small}" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource Toolbar.ControlHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
    </Style>

    <Style x:Key="ToolbarButtonPrimary" BasedOn="{StaticResource ButtonPrimary.Small}" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource Toolbar.ControlHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
    </Style>

    <!-- Square icon button in a toolbar; the icon goes in Tag as Geometry -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource Toolbar.ControlHeight}" />
        <Setter Property="Height" Value="{StaticResource Toolbar.ControlHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Background="Transparent"
                        CornerRadius="{StaticResource Radius.Sm}">
                        <Path
                            Width="14"
                            Height="14"
                            Data="{TemplateBinding Tag}"
                            Fill="{TemplateBinding Foreground}"
                            Stretch="Uniform" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover.RowBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text button with an icon, flat until hovered (top bar, panel actions) -->
    <Style x:Key="FlatButton" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource Toolbar.ControlHeight}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="{StaticResource Radius.Sm}">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Path
                                x:Name="Glyph"
                                Width="13"
                                Height="13"
                                Margin="0,0,6,0"
                                Data="{TemplateBinding Tag}"
                                Fill="{TemplateBinding Foreground}"
                                Stretch="Uniform" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover.RowBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A strip across a panel with a notice; the tone comes from Background/Foreground -->
    <Style x:Key="Banner" TargetType="Border">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!--
        Dense table, as in the Terminal: thin rows, the separator drawn under the highlight, column lines only
        between columns.
    -->
    <converters:LastColumnConverter x:Key="IsLastColumn" />

    <Style x:Key="TerminalColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle.Small}" TargetType="DataGridColumnHeader">
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryRegionBrush}" />
        <Style.Triggers>
            <DataTrigger Value="True">
                <DataTrigger.Binding>
                    <MultiBinding Converter="{StaticResource IsLastColumn}">
                        <Binding Path="Column" RelativeSource="{RelativeSource Self}" />
                        <Binding Path="DisplayIndex" RelativeSource="{RelativeSource Self}" />
                        <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                    </MultiBinding>
                </DataTrigger.Binding>
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TerminalDataGridRow" BasedOn="{StaticResource DataGridRowStyle.Small}" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Grid>
                        <Border
                            Margin="0,1,0,2"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Sm}" />
                        <DataGridCellsPresenter
                            Margin="0,0,0,1"
                            ItemsPanel="{TemplateBinding ItemsPanel}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        <Border
                            Height="1"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource SecondaryRegionBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Hover.RowBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Selection.RowBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TerminalDataGridCell" BasedOn="{StaticResource DataGridCellStyle.Small}" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryRegionBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            Margin="0,0,3,0"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            </Trigger>
            <DataTrigger Value="True">
                <DataTrigger.Binding>
                    <MultiBinding Converter="{StaticResource IsLastColumn}">
                        <Binding Path="Column" RelativeSource="{RelativeSource Self}" />
                        <Binding Path="Column.DisplayIndex" RelativeSource="{RelativeSource Self}" />
                        <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                        <Binding Path="Column.Visibility" RelativeSource="{RelativeSource Self}" />
                    </MultiBinding>
                </DataTrigger.Binding>
                <Setter Property="BorderThickness" Value="0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TerminalDataGrid" BasedOn="{StaticResource DataGrid.Small}" TargetType="DataGrid">
        <Setter Property="RowStyle" Value="{StaticResource TerminalDataGridRow}" />
        <Setter Property="CellStyle" Value="{StaticResource TerminalDataGridCell}" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource TerminalColumnHeader}" />
        <Setter Property="behaviors:ScrollFade.IsEnabled" Value="True" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="IsSynchronizedWithCurrentItem" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowHeight" Value="24" />
        <Setter Property="ColumnHeaderHeight" Value="26" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
    </Style>

    <Style x:Key="NumberColumnHeader" BasedOn="{StaticResource TerminalColumnHeader}" TargetType="DataGridColumnHeader">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

    <Style x:Key="NumberCell" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Numbers}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <Style x:Key="TextCell" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Dialog card: grows from 95% and rises 10 px, as in the Terminal -->
    <Style x:Key="DialogBorderAnimated" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.XL}" />
        <Setter Property="Effect" Value="{StaticResource Shadow.Card}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                    <TranslateTransform Y="10" />
                </TransformGroup>
            </Setter.Value>
        </Setter>
        <Setter Property="Opacity" Value="0" />
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" From="0.95" To="1" Duration="0:0:0.25">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" From="0.95" To="1" Duration="0:0:0.25">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" From="10" To="0" Duration="0:0:0.25">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- Grey footer of a dialog with its buttons -->
    <Style x:Key="DialogFooter" TargetType="Border">
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
        <Setter Property="CornerRadius" Value="0,0,11,11" />
    </Style>

    <Style x:Key="DialogTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Lg}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Sidebar entry: one RadioButton group, the checked one gets the background and the accent mark -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Md}" />
                        <Border
                            x:Name="Mark"
                            Width="3"
                            Height="16"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource PrimaryBrush}"
                            CornerRadius="2"
                            Opacity="0" />
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover.RowBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                            <Setter TargetName="Mark" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavGroup" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.XS}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ThirdlyTextBrush}" />
        <Setter Property="Margin" Value="20,16,0,6" />
    </Style>

    <Style TargetType="controls:SettingRow">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SettingRow">
                    <Grid MinHeight="34" Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,4,12,4" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="{StaticResource FontSize.Body}"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                Text="{TemplateBinding Label}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,1,0,0"
                                FontSize="{StaticResource FontSize.Sm}"
                                Foreground="{DynamicResource ThirdlyTextBrush}"
                                Text="{TemplateBinding Description}"
                                TextWrapping="Wrap"
                                Visibility="{Binding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource String2VisibilityConverter}}" />
                        </StackPanel>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:SettingsPanel">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SettingsPanel">
                    <Border
                        Padding="16,12,16,12"
                        Background="{DynamicResource RegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Lg}">
                        <DockPanel>
                            <Grid Margin="0,0,0,10" DockPanel.Dock="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Width="30"
                                    Height="30"
                                    Margin="0,1,10,0"
                                    VerticalAlignment="Top">
                                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="{StaticResource Radius.Md}" Opacity="0.14" />
                                    <Path
                                        Width="13"
                                        Height="13"
                                        Data="{TemplateBinding Icon}"
                                        Fill="{DynamicResource PrimaryBrush}"
                                        Stretch="Uniform" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ContentPresenter
                                        ContentSource="Header"
                                        TextElement.FontSize="{StaticResource FontSize.Body}"
                                        TextElement.FontWeight="SemiBold"
                                        TextElement.Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock
                                        Margin="0,1,0,0"
                                        FontSize="{StaticResource FontSize.Sm}"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        Text="{TemplateBinding Description}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <ContentPresenter />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The cards of a settings page: as many columns as fit, levelled at the bottom -->
    <Style x:Key="SettingsPage" TargetType="controls:MasonryPanel">
        <Setter Property="MinColumnWidth" Value="340" />
        <Setter Property="MaxColumns" Value="3" />
        <Setter Property="Spacing" Value="12" />
    </Style>

    <!-- Title strip of a settings page: the name underlined in the accent over a hairline, as in Axiom -->
    <Style x:Key="PageTitle" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="DockPanel.Dock" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Grid Margin="2,0,0,0">
                                <ContentPresenter
                                    Margin="0,4,0,9"
                                    TextElement.FontSize="{StaticResource FontSize.Body}"
                                    TextElement.FontWeight="SemiBold"
                                    TextElement.Foreground="{DynamicResource PrimaryTextBrush}" />
                                <Border
                                    Height="2"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource PrimaryBrush}"
                                    CornerRadius="1" />
                            </Grid>
                            <TextBlock
                                Margin="14,4,0,9"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSize.Sm}"
                                Foreground="{DynamicResource ThirdlyTextBrush}"
                                Text="{TemplateBinding Tag}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A field at the end of a settings row: one width, so the rows line up -->
    <Style x:Key="RowField" BasedOn="{StaticResource ToolbarTextBox}" TargetType="{x:Type hc:TextBox}">
        <Setter Property="Width" Value="180" />
    </Style>

    <!-- Hairline between groups of rows in a card -->
    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,6" />
        <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    </Style>

    <!-- Switch at the end of a settings row -->
    <Style x:Key="RowSwitch" BasedOn="{StaticResource ToggleButtonSwitch.Small}" TargetType="ToggleButton" />

    <!-- The spinner only runs while it can be seen -->
    <Style BasedOn="{StaticResource {x:Type hc:LoadingCircle}}" TargetType="{x:Type hc:LoadingCircle}">
        <Setter Property="IsRunning" Value="{Binding IsVisible, RelativeSource={RelativeSource Self}}" />
    </Style>

</ResourceDictionary>
