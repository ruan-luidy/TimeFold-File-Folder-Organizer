<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Same exe name and version as the WinForms build, so the installer and release workflow keep working -->
    <AssemblyName>TimeFold</AssemblyName>
    <RootNamespace>TimeFold.Wpf</RootNamespace>
    <Version>1.1.1</Version>
    <ApplicationIcon>..\Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="HandyControls" Version="3.6.0" />
    <PackageReference Include="MahApps.Metro.IconPacks.PhosphorIcons" Version="6.2.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TimeFold.Core\TimeFold.Core.csproj" />
  </ItemGroup>

  <!-- The logo is shared with the WinForms project instead of copied -->
  <ItemGroup>
    <Resource Include="..\Assets\app.png" Link="Assets\app.png" />
    <Resource Include="..\Assets\app.ico" Link="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildTimestamp</_Parameter1>
      <_Parameter2>$([System.DateTime]::UtcNow.AddHours(5.5).ToString("yyyyMMdd.HHmmss"))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
