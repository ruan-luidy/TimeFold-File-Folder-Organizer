<controls:DialogCard
    x:Class="TimeFold.Wpf.Features.Tour.TourDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TimeFold.Wpf.Shared.Controls"
    xmlns:icons="clr-namespace:TimeFold.Wpf.Shared.Icons"
    Width="680"
    Background="Transparent">

    <Border Style="{StaticResource DialogBorderAnimated}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="430" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Margin="28,24,28,12">
                <!-- badge and step -->
                <DockPanel Margin="0,0,0,14" DockPanel.Dock="Top">
                    <TextBlock
                        x:Name="StepText"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Right"
                        Style="{StaticResource CaptionText}" />
                    <Border
                        x:Name="Badge"
                        Padding="10,4"
                        HorizontalAlignment="Left"
                        CornerRadius="999">
                        <StackPanel Orientation="Horizontal">
                            <Path
                                x:Name="BadgeIcon"
                                Width="12"
                                Height="12"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Stretch="Uniform" />
                            <TextBlock
                                x:Name="BadgeText"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSize.XS}"
                                FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </DockPanel>

                <TextBlock
                    x:Name="SlideTitle"
                    DockPanel.Dock="Top"
                    FontSize="{StaticResource FontSize.Title}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="SlideSubtitle"
                    Margin="0,4,0,14"
                    DockPanel.Dock="Top"
                    Style="{StaticResource CaptionText}" />

                <!-- theme choice, first slide only -->
                <UniformGrid
                    x:Name="ThemeChoice"
                    Margin="0,0,0,14"
                    Columns="2"
                    DockPanel.Dock="Top">
                    <RadioButton
                        x:Name="LightOption"
                        Margin="0,0,6,0"
                        Checked="Theme_Checked"
                        Style="{StaticResource OptionCard}">
                        <DockPanel>
                            <Border
                                Width="44"
                                Height="30"
                                Margin="0,0,10,0"
                                Background="#F3F3F5"
                                BorderBrush="#D0D0D6"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Border Margin="6,6,14,12" Background="#FFFFFF" CornerRadius="2" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Style="{StaticResource BodyText}" Text="Light" />
                                <TextBlock Style="{StaticResource CaptionText}" Text="Classic, for daytime focus" />
                            </StackPanel>
                        </DockPanel>
                    </RadioButton>
                    <RadioButton
                        x:Name="DarkOption"
                        Margin="6,0,0,0"
                        Checked="Theme_Checked"
                        Style="{StaticResource OptionCard}">
                        <DockPanel>
                            <Border
                                Width="44"
                                Height="30"
                                Margin="0,0,10,0"
                                Background="#111113"
                                BorderBrush="#3A3A3F"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Border Margin="6,6,14,12" Background="#1C1C1C" CornerRadius="2" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Style="{StaticResource BodyText}" Text="Dark" />
                                <TextBlock Style="{StaticResource CaptionText}" Text="Easy on the eyes at night" />
                            </StackPanel>
                        </DockPanel>
                    </RadioButton>
                </UniformGrid>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="Bullets">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,10">
                                    <Path
                                        Width="12"
                                        Height="12"
                                        Margin="0,3,10,0"
                                        VerticalAlignment="Top"
                                        Data="{icons:Phosphor CheckCircleFill}"
                                        Fill="{DynamicResource SuccessBrush}"
                                        Stretch="Uniform" />
                                    <!-- the two runs on one line: whitespace between them would show as a space -->
                                    <TextBlock Style="{StaticResource BodyText}"><Run FontWeight="SemiBold" Text="{Binding Head, Mode=OneWay}" /><Run Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding Body, Mode=OneWay}" /></TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <Border Grid.Row="1" Style="{StaticResource DialogFooter}">
                <DockPanel>
                    <ItemsControl
                        x:Name="Dots"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    x:Name="Dot"
                                    Width="7"
                                    Height="7"
                                    Margin="0,0,6,0"
                                    Background="{DynamicResource BorderBrush}"
                                    CornerRadius="4" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="True">
                                        <Setter TargetName="Dot" Property="Width" Value="18" />
                                        <Setter TargetName="Dot" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <CheckBox
                        x:Name="DontShowCheck"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Content="Don't show on startup"
                        DockPanel.Dock="Left" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            x:Name="SkipButton"
                            Margin="0,0,10,0"
                            Click="Skip_Click"
                            Content="Skip"
                            Style="{StaticResource ButtonDefault}" />
                        <Button
                            x:Name="BackButton"
                            Margin="0,0,10,0"
                            Click="Back_Click"
                            Content="Back"
                            Style="{StaticResource ButtonDefault}" />
                        <Button
                            x:Name="NextButton"
                            MinWidth="110"
                            Click="Next_Click"
                            Style="{StaticResource ButtonPrimary}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</controls:DialogCard>
