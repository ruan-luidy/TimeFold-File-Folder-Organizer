<UserControl
    x:Class="TimeFold.Wpf.Features.Naming.NamingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TimeFold.Wpf.Shared.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:TimeFold.Wpf.Shared.Icons"
    xmlns:local="clr-namespace:TimeFold.Wpf.Features.Naming"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:NamingViewModel}"
    mc:Ignorable="d">

    <DockPanel>
        <!-- live preview on top: the folders the template makes for four sample dates -->
        <Border Margin="0,0,0,12" DockPanel.Dock="Top" Style="{StaticResource SurfaceCard}" Padding="16,12">
            <StackPanel>
                <TextBlock Margin="0,0,0,8" Style="{StaticResource PanelHeaderText}" Text="MULTI-FOLDER PREVIEW" />
                <ItemsControl ItemsSource="{Binding Samples}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3,12,3">
                                <Path
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,8,0"
                                    Data="{icons:Phosphor FolderFill}"
                                    Fill="{DynamicResource WarningBrush}"
                                    Stretch="Uniform" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource FontFamily.Numbers}"
                                    FontSize="{StaticResource FontSize.Body}"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    Text="{Binding}"
                                    TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <controls:MasonryPanel Style="{StaticResource SettingsPage}">
            <controls:SettingsPanel
                Description="How date folders are named in the date and hybrid modes"
                Header="Date naming template"
                Icon="{icons:Phosphor CalendarBlankBold}">
                <StackPanel>
                    <controls:SelectField
                        Margin="0,0,0,8"
                        DisplayMemberPath="DisplayName"
                        GroupMemberPath="Group"
                        ItemsSource="{Binding Options}"
                        SelectedItem="{Binding SelectedOption}" />
                    <controls:SettingRow Description="Swap the order, e.g. 'March 2026' instead of '2026 March'" Label="Order" IsEnabled="{Binding CanFlip}">
                        <Button
                            MinWidth="130"
                            Command="{Binding ToggleFlipCommand}"
                            Content="{Binding FlipText}"
                            Style="{StaticResource ToolbarButton}" />
                    </controls:SettingRow>
                    <controls:SettingRow Description="'Mar' instead of 'March'" IsEnabled="{Binding CanShortMonth}" Label="Short month names">
                        <ToggleButton IsChecked="{Binding UseShortMonth}" Style="{StaticResource RowSwitch}" />
                    </controls:SettingRow>
                </StackPanel>
            </controls:SettingsPanel>

            <controls:SettingsPanel
                Description="Text added before or after every date folder name"
                Header="Prefix and suffix"
                Icon="{icons:Phosphor TextAaBold}">
                <StackPanel>
                    <controls:SettingRow Label="Folder prefix">
                        <hc:TextBox
                            hc:InfoElement.Placeholder="e.g. Photos_ or Project_"
                            MaxLength="{Binding MaxLength}"
                            Style="{StaticResource RowField}"
                            Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                    </controls:SettingRow>
                    <controls:SettingRow Label="Folder suffix">
                        <hc:TextBox
                            hc:InfoElement.Placeholder="e.g. _Archive or _Sorted"
                            MaxLength="{Binding MaxLength}"
                            Style="{StaticResource RowField}"
                            Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                    </controls:SettingRow>
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource CaptionText}"
                        Text="Characters Windows does not allow in names are dropped. A space is added between the text and the date unless it already ends in a space, _ or -." />
                </StackPanel>
            </controls:SettingsPanel>
        </controls:MasonryPanel>
    </DockPanel>
</UserControl>
