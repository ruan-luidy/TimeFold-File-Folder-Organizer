<UserControl
    x:Class="TimeFold.Wpf.Features.Preview.PreviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TimeFold.Wpf.Shared.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:TimeFold.Wpf.Shared.Icons"
    xmlns:local="clr-namespace:TimeFold.Wpf.Features.Preview"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:PreviewViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- A date cell: the date that drives the plan is bold, in the accent, with a check -->
        <Style x:Key="DateCell" BasedOn="{StaticResource TextCell}" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily.Numbers}" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>

        <Style x:Key="ActiveMark" TargetType="Path">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Data" Value="{icons:Phosphor CheckBold}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PreviewRowStyle" BasedOn="{StaticResource TerminalDataGridRow}" TargetType="DataGridRow">
            <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                    <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ContextMenu x:Key="RowMenu" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem
                Command="{Binding ToggleIgnoreCommand}"
                Header="{Binding Menu.IgnoreText}"
                Visibility="{Binding Menu.ShowIgnore, Converter={StaticResource Boolean2VisibilityConverter}}" />
            <MenuItem Command="{Binding OpenSelectedCommand}" Header="Open" InputGestureText="Enter" />
            <MenuItem Command="{Binding RevealSelectedCommand}" Header="Open in File Explorer" />
            <MenuItem Command="{Binding CopySelectedPathCommand}" Header="Copy File Path" />
            <Separator />
            <MenuItem
                Command="{Binding RenameSelectedCommand}"
                Header="Rename File..."
                InputGestureText="F2"
                Visibility="{Binding Menu.ShowRename, Converter={StaticResource Boolean2VisibilityConverter}}" />
            <MenuItem Command="{Binding DeleteSelectedCommand}" Header="Delete (Recycle Bin)" InputGestureText="Del" />
            <Separator Visibility="{Binding Menu.ShowCategorySection, Converter={StaticResource Boolean2VisibilityConverter}}" />
            <MenuItem
                Command="{Binding RenameCategoryCommand}"
                Header="{Binding Menu.RenameCategoryText}"
                Visibility="{Binding Menu.ShowRenameCategory, Converter={StaticResource Boolean2VisibilityConverter}}" />
            <MenuItem
                Command="{Binding ResetCategoryNameCommand}"
                Header="{Binding Menu.ResetCategoryText}"
                Visibility="{Binding Menu.ShowResetCategory, Converter={StaticResource Boolean2VisibilityConverter}}" />
            <MenuItem
                Command="{Binding ChangeCategoryCommand}"
                Header="{Binding Menu.ChangeCategoryText}"
                Visibility="{Binding Menu.ShowChangeCategory, Converter={StaticResource Boolean2VisibilityConverter}}" />
            <Separator />
            <MenuItem Command="{Binding SelectAllCommand}" Header="Select All" />
            <MenuItem Command="{Binding DeselectAllCommand}" Header="Deselect All" />
            <MenuItem Command="{Binding InvertSelectionCommand}" Header="Invert Selection" />
        </ContextMenu>
    </UserControl.Resources>

    <Border Padding="0" Style="{StaticResource SurfaceCard}">
        <DockPanel>
            <!-- Toolbar: title and counts on the left, filter and actions on the right -->
            <DockPanel Margin="12,10,10,8" DockPanel.Dock="Top">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <hc:TextBox
                        Width="180"
                        Margin="0,0,8,0"
                        hc:InfoElement.Placeholder="Filter by name, type or folder"
                        Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Command="{Binding SelectAllCommand}"
                        Style="{StaticResource IconButton}"
                        Tag="{icons:Phosphor CheckSquareBold}"
                        ToolTip="Select all" />
                    <Button
                        Command="{Binding DeselectAllCommand}"
                        Style="{StaticResource IconButton}"
                        Tag="{icons:Phosphor SquareBold}"
                        ToolTip="Deselect all" />
                    <Button
                        Command="{Binding InvertSelectionCommand}"
                        Style="{StaticResource IconButton}"
                        Tag="{icons:Phosphor ShuffleBold}"
                        ToolTip="Invert selection" />
                    <Rectangle
                        Width="1"
                        Height="16"
                        Margin="6,0"
                        Fill="{DynamicResource BorderBrush}" />
                    <Button
                        Command="{Binding LoadCommand}"
                        Content="Refresh"
                        IsEnabled="{Binding HasSource}"
                        Style="{StaticResource FlatButton}"
                        Tag="{icons:Phosphor ArrowClockwiseBold}"
                        ToolTip="Scan and refresh the organization plan (F5)" />
                </StackPanel>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource PanelHeaderText}" Text="LIVE PREVIEW" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionText}"
                        Text="{Binding CountText}" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSize.Sm}"
                        Visibility="{Binding HasIgnored, Converter={StaticResource Boolean2VisibilityConverter}}">
                        <Hyperlink
                            Command="{Binding OpenExclusionsCommand}"
                            Foreground="{DynamicResource DangerBrush}"
                            TextDecorations="{x:Null}"
                            ToolTip="Click to view or edit folder exclusion rules">
                            <Run Text="{Binding IgnoredText, Mode=OneWay}" />
                        </Hyperlink>
                    </TextBlock>
                    <hc:LoadingCircle
                        Width="14"
                        Height="14"
                        Margin="10,0,0,0"
                        DotDiameter="2.5"
                        Visibility="{Binding IsScanning, Converter={StaticResource Boolean2VisibilityConverter}}" />
                </StackPanel>
            </DockPanel>

            <!-- Notices: conflicts (red), timestamps (amber), paused exclusions (amber) -->
            <StackPanel Margin="10,0,10,2" DockPanel.Dock="Top">
                <Border
                    Background="{DynamicResource DangerBrush}"
                    BorderBrush="Transparent"
                    Style="{StaticResource Banner}"
                    Visibility="{Binding HasConflicts, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <DockPanel>
                        <Button
                            Padding="8,0"
                            Command="{Binding ReviewConflictsCommand}"
                            Content="Review"
                            DockPanel.Dock="Right"
                            Foreground="White"
                            Style="{StaticResource FlatButton}" />
                        <Path
                            Width="14"
                            Height="14"
                            Margin="0,0,8,0"
                            Data="{icons:Phosphor WarningBold}"
                            Fill="White"
                            Stretch="Uniform" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="{StaticResource FontSize.Sm}"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="{Binding ConflictText}"
                            TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <Border
                    Background="{DynamicResource WarningBrush}"
                    BorderBrush="Transparent"
                    Style="{StaticResource Banner}"
                    Visibility="{Binding HasTimestampWarning, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <DockPanel>
                        <Path
                            Width="14"
                            Height="14"
                            Margin="0,0,8,0"
                            Data="{icons:Phosphor ClockCountdownBold}"
                            Fill="Black"
                            Stretch="Uniform" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="{StaticResource FontSize.Sm}"
                            FontWeight="SemiBold"
                            Foreground="Black"
                            Text="{Binding TimestampWarning}"
                            TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <Border
                    Background="{DynamicResource WarningBrush}"
                    BorderBrush="Transparent"
                    Style="{StaticResource Banner}"
                    Visibility="{Binding HasExclusionsPaused, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <DockPanel>
                        <Button
                            Padding="8,0"
                            Command="{Binding ResumeExclusionsCommand}"
                            Content="Resume protection"
                            DockPanel.Dock="Right"
                            Foreground="Black"
                            Style="{StaticResource FlatButton}" />
                        <Path
                            Width="14"
                            Height="14"
                            Margin="0,0,8,0"
                            Data="{icons:Phosphor PauseCircleBold}"
                            Fill="Black"
                            Stretch="Uniform" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="{StaticResource FontSize.Sm}"
                            FontWeight="SemiBold"
                            Foreground="Black"
                            Text="{Binding ExclusionsPausedText}"
                            TextWrapping="Wrap" />
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- More rows than the preview limit -->
            <Button
                Margin="10,4,10,10"
                HorizontalAlignment="Stretch"
                Command="{Binding LoadMoreCommand}"
                Content="{Binding LoadMoreText}"
                DockPanel.Dock="Bottom"
                Style="{StaticResource ToolbarButton}"
                Visibility="{Binding HasMore, Converter={StaticResource Boolean2VisibilityConverter}}" />

            <Grid>
                <DataGrid
                    x:Name="Grid"
                    Margin="6,0,6,0"
                    CanUserSortColumns="True"
                    ContextMenu="{StaticResource RowMenu}"
                    ItemsSource="{Binding RowsView}"
                    MouseDoubleClick="Grid_MouseDoubleClick"
                    PreviewKeyDown="Grid_PreviewKeyDown"
                    PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown"
                    RowStyle="{StaticResource PreviewRowStyle}"
                    SelectedItem="{Binding SelectedRow}"
                    Sorting="Grid_Sorting"
                    Style="{StaticResource TerminalDataGrid}"
                    Tag="{Binding}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn
                            Width="34"
                            CanUserResize="False"
                            CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Focusable="False"
                                        IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn
                            Width="1.3*"
                            MinWidth="120"
                            Header="File Name"
                            SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Path
                                            x:Name="KindIcon"
                                            Width="14"
                                            Height="14"
                                            Margin="4,0,6,0"
                                            VerticalAlignment="Center"
                                            Data="{icons:Phosphor FileBold}"
                                            Fill="{DynamicResource SecondaryTextBrush}"
                                            Stretch="Uniform" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource PrimaryTextBrush}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding Item.FullPath}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Folder">
                                            <Setter TargetName="KindIcon" Property="Data" Value="{icons:Phosphor FolderFill}" />
                                            <Setter TargetName="KindIcon" Property="Fill" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="GitRepo">
                                            <Setter TargetName="KindIcon" Property="Data" Value="{icons:Phosphor GitBranchBold}" />
                                            <Setter TargetName="KindIcon" Property="Fill" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="IgnoredFolder">
                                            <Setter TargetName="KindIcon" Property="Data" Value="{icons:Phosphor ShieldCheckBold}" />
                                            <Setter TargetName="KindIcon" Property="Fill" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn
                            Width="Auto"
                            MinWidth="56"
                            MaxWidth="120"
                            Header="Type"
                            SortMemberPath="Type">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        Style="{StaticResource TextCell}"
                                        Text="{Binding TypeDisplay}"
                                        ToolTip="{Binding TypeTooltip}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn
                            Width="142"
                            Header="Modified"
                            SortMemberPath="Modified">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Background="Transparent" Orientation="Horizontal" ToolTip="{Binding DateTooltip}">
                                        <TextBlock x:Name="Date" Style="{StaticResource DateCell}" Text="{Binding Modified}" />
                                        <Path x:Name="Mark" Style="{StaticResource ActiveMark}" Visibility="Collapsed" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsModifiedActive}" Value="True">
                                            <Setter TargetName="Date" Property="FontWeight" Value="Bold" />
                                            <Setter TargetName="Date" Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn
                            Width="142"
                            Header="Created"
                            SortMemberPath="Created">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Background="Transparent" Orientation="Horizontal" ToolTip="{Binding DateTooltip}">
                                        <TextBlock x:Name="Date" Style="{StaticResource DateCell}" Text="{Binding Created}" />
                                        <Path x:Name="Mark" Style="{StaticResource ActiveMark}" Visibility="Collapsed" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCreatedActive}" Value="True">
                                            <Setter TargetName="Date" Property="FontWeight" Value="Bold" />
                                            <Setter TargetName="Date" Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Shown only when some media in the folder has EXIF / camera dates -->
                        <DataGridTemplateColumn
                            x:Name="TakenColumn"
                            Width="142"
                            Header="Date Taken"
                            SortMemberPath="Taken"
                            Visibility="Collapsed">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Background="Transparent" Orientation="Horizontal" ToolTip="{Binding DateTooltip}">
                                        <TextBlock x:Name="Date" Style="{StaticResource DateCell}" Text="{Binding Taken}" />
                                        <Path x:Name="Mark" Style="{StaticResource ActiveMark}" Visibility="Collapsed" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsTakenActive}" Value="True">
                                            <Setter TargetName="Date" Property="FontWeight" Value="Bold" />
                                            <Setter TargetName="Date" Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn
                            Width="*"
                            MinWidth="130"
                            Header="Target Folder"
                            SortMemberPath="Target">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Background="Transparent" Orientation="Horizontal" ToolTip="{Binding TargetTooltip}">
                                        <Path
                                            x:Name="Icon"
                                            Width="12"
                                            Height="12"
                                            Margin="4,0,6,0"
                                            VerticalAlignment="Center"
                                            Data="{icons:Phosphor FolderOpenBold}"
                                            Fill="{DynamicResource Target.Brush}"
                                            Stretch="Uniform" />
                                        <TextBlock
                                            x:Name="Text"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource Target.Brush}"
                                            Text="{Binding Target}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCustomRoute}" Value="True">
                                            <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource Target.CustomBrush}" />
                                            <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Target.CustomBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="Text" Property="FontWeight" Value="Normal" />
                                            <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn
                            Width="Auto"
                            MinWidth="96"
                            Header="Status"
                            SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel
                                        Margin="4,0"
                                        Background="Transparent"
                                        Orientation="Horizontal"
                                        ToolTip="{Binding StatusTooltip}">
                                        <Ellipse
                                            x:Name="Dot"
                                            Width="7"
                                            Height="7"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Fill="{DynamicResource SuccessBrush}" />
                                        <TextBlock
                                            x:Name="Text"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource SuccessBrush}"
                                            Text="{Binding StatusText}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Conflict">
                                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource DangerBrush}" />
                                            <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            <Setter TargetName="Text" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Excluded">
                                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource WarningBrush}" />
                                            <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            <Setter TargetName="Text" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Unchecked">
                                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource ThirdlyTextBrush}" />
                                            <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn
                            Width="76"
                            HeaderStyle="{StaticResource NumberColumnHeader}"
                            Header="Size"
                            SortMemberPath="Size">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        Style="{StaticResource NumberCell}"
                                        Text="{Binding Size}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Folder chosen but nothing to show -->
                <controls:EmptyState
                    Icon="{icons:Phosphor FolderDashedBold}"
                    Text="The folder is empty, or every item is filtered out by your settings (folders off, system files ignored)."
                    Title="No files found to organize">
                    <controls:EmptyState.Style>
                        <Style TargetType="controls:EmptyState">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasSource}" Value="True" />
                                        <Condition Binding="{Binding HasFiles}" Value="False" />
                                        <Condition Binding="{Binding IsScanning}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:EmptyState.Style>
                </controls:EmptyState>

                <!-- No folder yet -->
                <controls:EmptyState
                    ActionCommand="{Binding BrowseCommand}"
                    ActionText="Choose a folder"
                    Icon="{icons:Phosphor FolderOpenBold}"
                    Text="Choose a source folder on the left, or drag and drop a folder anywhere on this window, to preview where everything will go."
                    Title="No files loaded yet"
                    Visibility="{Binding HasSource, Converter={StaticResource Boolean2VisibilityReConverter}}" />
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
